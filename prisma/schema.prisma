// MathLab Database Schema
// Based on docs/planning/04-database-design.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// FEAT-0: User Management
enum Role {
  STUDENT
  TEACHER
  MANAGER
  OWNER
  SUPER_ADMIN
}

// FEAT: 이용권(라이선스) 시스템 — 기능별 좌석 관리
enum LicenseFeature {
  CONCEPT
  ARITHMETIC
  TIME_ATTACK
  TEST
  REVENGE
  DIAGNOSTIC
  QUIZ
  EXAM_ANALYSIS
  HOMEWORK
  WORKSHEET
  EXAM_PREP
  OX_QUIZ
  WORKBOOK
}

// FEAT: 기출 분석 시스템
enum ExamPaperStatus {
  PENDING
  ANALYZING
  COMPLETED
  FAILED
}

enum ExamSubject {
  MATH
  ENGLISH
}

// FEAT: 멀티테넌시 — 지점(학원) 관리
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(50) // 지점 식별자 (내부용 — 로고 경로/View-As 등)
  name      String   @db.VarChar(100) // 표시명: "강남점"
  logo      String?  @db.VarChar(500) // 커스텀 로고 URL
  settings  Json? // 지점별 설정 (색상, 기능 토글 등)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  nearbyGroups            TenantNearbyGroup[]
  questions               Question[]
  subscription            TenantSubscription?
  entitlements            TenantEntitlement[]
  studentLicenses         StudentLicense[]
  entitlementLedgers      EntitlementLedger[]
  creditLots              EntitlementCreditLot[]

  @@index([slug])
  @@index([isActive])
}

// FEAT: 구독/결제 (토스페이먼츠 빌링, para-x 결제 허브 경유) — 지점(테넌트) 단위 구독.
// 행 없음 = free/inactive 기본. 쓰기 경로는 셋뿐이다:
//   ① /api/webhooks/parax        — 결제 허브의 지급·해지 통지 (정상 경로)
//   ② /api/billing/cancel        — 허브가 해지를 확인해 준 뒤 로컬 상태를 같은 값으로 수렴(멱등)
//   ③ /api/admin/tenants (PATCH) — SUPER_ADMIN 수동 배정
// ⚠️ DB에는 폐지된 Lemon Squeezy 컬럼(ls_customer_id / ls_subscription_id / ls_variant_id)이
//    아직 물리적으로 남아 있다(데이터 0건, 참조 코드 없음). 별도 DDL 로 정리 예정.
model TenantSubscription {
  id               String    @id @default(cuid())
  tenantId         String    @unique
  plan             String    @default("free")     @db.VarChar(20) // free | pro | enterprise
  status           String    @default("inactive") @db.VarChar(20) // inactive | active | cancelled | expired | past_due
  // 토스페이먼츠 빌링키 (para-x 결제 허브가 웹훅으로 전달)
  tossBillingKey     String? @db.VarChar(200)
  tossCustomerKey    String? @db.VarChar(100)
  tossSubscriptionId String? @db.VarChar(100)
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan])
}

model User {
  id           String    @id @default(cuid())
  seq          Int       @unique @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @db.VarChar(255)
  name         String    @db.VarChar(50)
  role         Role      @default(STUDENT)
  grade        Int?
  phone        String?   @db.VarChar(20)
  email        String?   @db.VarChar(100)
  school       String?   @db.VarChar(100)
  birthDate    DateTime?
  address      String?   @db.VarChar(200)
  startDate    DateTime?
  notes        String?   @db.Text
  parentName   String?   @db.VarChar(50)
  parentPhone  String?   @db.VarChar(20)
  classroomId  String?
  tenantId     String?
  profileImage String?   @db.VarChar(500)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant                       Tenant?                        @relation(fields: [tenantId], references: [id])
  examPapersAsTeacher          ExamPaper[]                    @relation("ExamPaperTeacher")
  examPapersAsStudent          ExamPaper[]                    @relation("ExamPaperStudent")
  analyzedExams                ExamAnalysis[]                 @relation("ExamAnalysisAnalyzedBy")
  runExamExtensions            ExamAnalysisExtension[]        @relation("ExamAnalysisExtensionLastRunBy")
  articleCopyEvents            ArticleCopyEvent[]
  createdQuestions             Question[]                     @relation("createdQuestions")

  @@index([role])
  @@index([classroomId])
  @@index([tenantId])
  @@index([tenantId, role])
}

// FEAT-1: Subject & Concept

model Concept {
  id           String   @id @default(cuid())
  subjectId    String
  title        String   @db.VarChar(200)
  fullContent  String   @db.Text
  visualAssets Json?
  sortOrder    Int      @default(0)
  conceptCode  String?  @unique @db.VarChar(20)
  grade        String?  @db.VarChar(20)
  semester     Int? // 학기: 1 또는 2
  chapter      String?  @db.VarChar(100) // 대단원: "자연수의 혼합 계산"
  section      String?  @db.VarChar(100) // 중단원: "덧셈과 뺄셈이 섞여 있는 식"
  sectionSub   String?  @db.VarChar(100) // 소단원
  category     String?  @db.VarChar(20)
  part         String?  @db.VarChar(20)
  source       String?  @db.VarChar(200) // 출처
  keywords     String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questions              Question[]

  @@index([subjectId])
  @@index([subjectId, sortOrder])
  @@index([conceptCode])
}

// FEAT-1: Learning Progress
enum Stage {
  READING
  BLANK_EASY
  BLANK_HARD
  BLANK_FULL
  BLANK_PAGE
}

// FEAT: 빈칸 학습 시도 이력 (개별 답변 저장)

// FEAT-1: Gamification
enum PointTransactionType {
  EARN
  SPEND
}

// FEAT: XP 상점
enum ShopItemCategory {
  FRAME // 아바타 테두리
  BACKGROUND // 프로필 카드 배경
  TITLE // 칭호
  NAME_COLOR // 닉네임 색상
  AVATAR // 아바타 포즈
  EFFECT // 아바타 이펙트 (CSS 애니메이션)
  HAT // 모자 악세사리
  GLASSES // 안경 악세사리
}

// FEAT-2: Question Bank
enum QuestionDifficulty {
  BASIC // 하
  MEDIUM // 중
  HIGH // 상
  HIGHEST // 최상
}

enum QuestionType {
  MULTIPLE_CHOICE // 객관식
  SHORT_ANSWER // 단답형
  ESSAY // 서술형
}

model Question {
  id          String  @id @default(cuid())
  bookCode    String  @db.VarChar(10) // "1-1" ~ "3-2"
  chapter     String  @db.VarChar(200) // 대단원
  section     String? @db.VarChar(200) // 중단원/코너
  questionNum Int // 문제 번호
  pageNum     Int? // PDF 페이지

  difficulty      QuestionDifficulty
  type            QuestionType
  content         String             @db.Text
  choices         Json? // ["①...", "②...", ...]
  answer          String             @db.Text
  explanation     String?            @db.Text
  scoringCriteria String?            @db.Text // 채점 요소 (해설에서 분리)
  source          String?            @db.VarChar(200) // 교재 출처 (예: "RPM 중1-1")
  sourceTag       String?            @db.VarChar(100) // "핵심문제 익히기" 등
  diagramSpec     Json? // 구조화된 도형 명세 (다형성 JSON)
  diagramSVG      String?            @db.Text // 레거시 raw SVG (하위 호환)
  choiceColumns   Int? // 보기 열 수: null=자동, 1=1열, 2=2열

  // 영역 분류 & 계통도 연결
  domain        String? @db.VarChar(30) // 5대 교육과정 영역: number | algebra | function | geometry | statistics
  abilityDomain String? @db.VarChar(30) // 4대 능력 영역: CALCULATION | UNDERSTANDING | PROBLEM_SOLVING | REASONING
  conceptId     String? // 연결된 개념 (계통도 분석용)

  // 지점/생성자 메타데이터
  tenantId    String? // 생성 지점 (null=공용/레거시)
  createdById String? // 생성한 선생님
  examPaperId String? // 기출 시험지 출처 (배치 추출)

  // 드래프트(임시 저장) — PDF 추출 중 크래시 대비
  isDraft      Boolean @default(false)
  draftBatchId String? @db.VarChar(40) // 클라이언트 생성 UUID (추출 세션 단위)
  draftOwnerId String? // 드래프트 소유 선생님

  // 동형 변형(숫자만 다른 같은 유형) — 원본↔변형 연결
  variantOfId   String? // 원본 문제 ID (변형이면 채워짐, 원본이면 null)
  variantSeed   Int? // 같은 원본의 N번째 변형 (1, 2, 3, ...)
  variantSource String? @db.VarChar(20) // 'ai' | 'rule' | 'manual' (생성 방법)

  concept         Concept?         @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("createdQuestions", fields: [createdById], references: [id], onDelete: SetNull)
  examPaper       ExamPaper?       @relation("ExamPaperQuestions", fields: [examPaperId], references: [id], onDelete: SetNull)
  variantOf       Question?        @relation("QuestionVariants", fields: [variantOfId], references: [id], onDelete: Cascade)
  variants        Question[]       @relation("QuestionVariants")

  // 중간테이블 역방향 관계

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantOfId, variantSeed])
  @@index([bookCode])
  @@index([bookCode, chapter])
  @@index([difficulty])
  @@index([type])
  @@index([domain])
  @@index([conceptId])
  @@index([examPaperId])
  @@index([isDraft, draftOwnerId])
  @@index([draftBatchId])
  @@index([variantOfId])
  @@index([tenantId])
  @@index([createdById])
}

// Concept Prerequisites (self-referencing many-to-many)

