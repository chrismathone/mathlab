// ── 문제 중간테이블 (questionIds Json → 관계형 전환) ──

// FEAT: 이용권 시스템 — 지점 이용권 풀 (para-x 결제로 충전)
model TenantEntitlement {
  id             String         @id @default(cuid())
  tenantId       String
  feature        LicenseFeature
  balance        Int            @default(0) // 남은 이용권 (충전 - 배정)
  totalPurchased Int            @default(0) // 누적 구매량
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feature])
  @@index([tenantId])
}

// FEAT: 이용권 시스템 — 학생 개별 배정 (지점 풀 → 학생, 소비는 Phase 3)
model StudentLicense {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  feature   LicenseFeature
  allocated Int            @default(0) // 배정량
  used      Int            @default(0) // 사용량 (잔여 = allocated - used)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, feature])
  @@index([tenantId])
  @@index([userId])
}

// FEAT: 이용권 시스템 — 충전 단위 Lot (약관 제6조: 충전일로부터 1년 유효, 경과 시 소멸)
// userId null = 지점 풀 보유분, 값 = 학생 배정분 (배정 시 풀 lot 에서 분할, 만료일 승계).
// 사용 가능 잔액 = SUM(remaining) WHERE expiresAt > now — 만료는 sweep 없이 조회 시점 계산으로 처리.
model EntitlementCreditLot {
  id         String         @id @default(cuid())
  tenantId   String
  userId     String? // null = 지점 풀, 값 = 학생 배정분
  feature    LicenseFeature
  granted    Int // 이 lot 에 들어온 양
  remaining  Int // 남은 양 (만료 임박분 우선 — FIFO by expiresAt 로 차감)
  grantedAt  DateTime       @default(now()) // 충전일 (만료 기산일)
  expiresAt  DateTime // grantedAt + 1년
  refOrderId String?        @db.VarChar(120) // 구매 주문 참조 (멱등은 ledger 가 담당)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, feature, expiresAt])
  @@index([tenantId, userId, feature, expiresAt])
}

// FEAT: 이용권 시스템 — 거래 원장 (감사·멱등). refOrderId = para-x 주문당 1행.
model EntitlementLedger {
  id         String          @id @default(cuid())
  tenantId   String
  userId     String?
  feature    LicenseFeature?
  delta      Int // +충전/배정, -소비
  reason     String          @db.VarChar(20) // purchase | allocate | consume | refund
  refOrderId String?         @unique
  amount     Int? // 결제금액(원) — purchase 시
  createdAt  DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ══════════════════════════════════════════════════════════════
// FEAT: 기출 분석 (Exam Analysis) — Math Report 이식
// ══════════════════════════════════════════════════════════════

model ExamPaper {
  id                     String          @id @default(cuid())
  tenantId               String
  teacherId              String
  studentId              String?
  title                  String          @db.VarChar(200)
  subject                ExamSubject     @default(MATH)
  grade                  String          @db.VarChar(30)
  category               String?         @db.VarChar(50)
  unit                   String?         @db.VarChar(200)
  examScope              Json?
  /// 학교가 공지한 실측 성적 지표 — 과목평균·응시자수·성취도 A~E 분포.
  /// **대부분의 시험지에서 영원히 null 이다.** 성적표는 시험 2~4주 뒤에 나오므로
  /// "시험 직후 발행" 워크플로 밖이고, 학교가 공지하지 않으면 알 방법이 없다.
  /// 부분 입력(평균만 알고 분포는 모름)이 정상이라 축마다 독립적으로 null 을 허용한다.
  /// 형태·정규화는 shared/exam-stats.ts 단일 소스. 절대 기본값으로 채우지 말 것(§12-11).
  examStats              Json?
  schoolName             String?         @db.VarChar(100)
  schoolId               String?         @db.VarChar(50) // FK → School (자동 매칭)
  examType               String          @default("blank") @db.VarChar(20)
  fileUrls               String          @db.Text
  fileType               String          @db.VarChar(20)
  status                 ExamPaperStatus @default(PENDING)
  analysisStep           Int             @default(0) // 0=대기, 1=파일로드, 2=분류, 3=AI분석, 4=저장
  errorMessage           String?         @db.Text
  extractedToBankAt      DateTime? // 문제은행에 추출된 시각 (내신대비 자동 감지용)
  extractedQuestionCount Int? // 추출된 문제 수
  // ── 배치 추출 승인/재시도 메타 ──
  extractApproved        Boolean         @default(false) // SUPER_ADMIN 승인 여부
  extractApprovedBy      String? // 승인자 userId
  extractApprovedAt      DateTime?
  extractAttempts        Int             @default(0) // 배치 시도 횟수
  lastExtractError       String?         @db.Text // 최근 추출 실패 사유
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  teacher            User                  @relation("ExamPaperTeacher", fields: [teacherId], references: [id])
  student            User?                 @relation("ExamPaperStudent", fields: [studentId], references: [id])
  school             School?               @relation(fields: [schoolId], references: [id])
  analyses           ExamAnalysis[]
  extractedQuestions Question[]            @relation("ExamPaperQuestions")
  articleCopyEvents  ArticleCopyEvent[]

  @@index([tenantId])
  @@index([teacherId])
  @@index([tenantId, subject])
  @@index([schoolId])
  @@index([status, extractApproved, extractedToBankAt])
}

model ExamAnalysis {
  id              String    @id @default(cuid())
  examPaperId     String
  questions       Json
  summary         Json?
  markDetection   Json?
  crossValidation Json?
  modelVersion    String?   @db.VarChar(50)
  totalQuestions  Int?
  totalPoints     Int?
  earnedPoints    Int?
  analyzedAt      DateTime?
  analyzedBy      String? // 분석 마지막 실행자 userId (재실행 시 갱신)
  createdAt       DateTime  @default(now())

  examPaper      ExamPaper               @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  extensions     ExamAnalysisExtension[]
  analyzedByUser User?                   @relation("ExamAnalysisAnalyzedBy", fields: [analyzedBy], references: [id])

  @@index([examPaperId])
  @@index([analyzedBy])
}

model ExamAnalysisExtension {
  id           String    @id @default(cuid())
  analysisId   String
  agentType    String    @db.VarChar(30)
  result       Json
  errorMessage String?   @db.Text
  lastRunBy    String? // 마지막 실행자 userId (재실행 시 갱신, 예: commentary, blog-article 등)
  lastRunAt    DateTime? // 마지막 실행 시각 (createdAt은 최초 생성, lastRunAt은 갱신 추적)
  createdAt    DateTime  @default(now())

  analysis      ExamAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  lastRunByUser User?        @relation("ExamAnalysisExtensionLastRunBy", fields: [lastRunBy], references: [id])

  @@unique([analysisId, agentType])
  @@index([analysisId])
  @@index([lastRunBy])
}

// ── 블로그 글 복사 이벤트 (append-only 로그) ──
// 강사가 "서식 복사" 버튼으로 네이버 블로그 등에 복사한 시점을 추적.
// 강사별 활동 로그 화면(/exam-analysis/admin "강사" 탭)에서 시간순 표시.
model ArticleCopyEvent {
  id          String   @id @default(cuid())
  examPaperId String
  userId      String
  copiedAt    DateTime @default(now())

  examPaper ExamPaper @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([examPaperId])
  @@index([userId])
  @@index([copiedAt])
}

// ── 패턴 시스템 (오답 패턴 DB) ──

model ExamErrorPattern {
  id                String      @id @default(cuid())
  subject           ExamSubject
  name              String      @db.VarChar(200)
  description       String      @db.Text
  errorType         String      @default("concept") @db.VarChar(30)
  frequency         Int         @default(0)
  severity          Int         @default(1)
  wrongExamples     Json?
  correctExamples   Json?
  feedbackMessage   String?     @db.Text
  detectionKeywords Json?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([subject])
}

model ExamPromptTemplate {
  id        String      @id @default(cuid())
  subject   ExamSubject
  agentType String      @db.VarChar(30)
  name      String      @db.VarChar(200)
  version   Int         @default(1)
  template  String      @db.Text
  variables Json?
  isActive  Boolean     @default(true)
  isDefault Boolean     @default(false)
  createdBy String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([subject, agentType, version])
  @@index([subject, agentType, isActive])
}

// ── 트렌드 + 참조 문제 ──

model ExamSchoolTrend {
  id         String      @id @default(cuid())
  tenantId   String
  subject    ExamSubject
  grade      String      @db.VarChar(30)
  period     String      @db.VarChar(30)
  schoolName String?     @db.VarChar(100)
  trendData  Json
  sampleSize Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // 확장 필드
  trendSummary   Json? // { difficultyLevel, characteristics, focusAreas }
  aiInsight      String? @db.Text
  topicFrequency Json? // [{topic, count, pct, avgDifficulty, totalPoints}]

  @@index([tenantId, subject, grade])
  @@index([period])
  @@index([schoolName])
}

model ExamQuestionReference {
  id           String      @id @default(cuid())
  subject      ExamSubject
  grade        String      @db.VarChar(30)
  difficulty   String      @db.VarChar(20)
  questionType String      @db.VarChar(30)
  content      String      @db.Text
  answer       String?     @db.Text
  source       String?     @db.VarChar(200)
  metadata     Json?
  createdAt    DateTime    @default(now())

  // 자동수집 + 검토 워크플로 필드
  reviewStatus   String    @default("pending") @db.VarChar(20) // pending, approved, rejected
  examPaperId    String?
  analysisId     String?
  questionNumber Int?
  confidence     Float?
  topicHierarchy String?   @db.VarChar(300)
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewNote     String?   @db.Text

  @@index([subject, grade])
  @@index([difficulty])
  @@index([reviewStatus])
  @@index([examPaperId])
}

// ── 피드백 시스템 (선생님 교정 → 학습 루프) ──

model ExamFeedback {
  id             String    @id @default(cuid())
  tenantId       String
  examPaperId    String
  analysisId     String?
  questionNumber Int?
  feedbackType   String    @db.VarChar(30) // wrong_topic, wrong_difficulty, wrong_recognition, other
  correction     Json?
  comment        String?   @db.Text
  teacherId      String
  status         String    @default("pending") @db.VarChar(20) // pending, processed, applied
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId])
  @@index([examPaperId])
  @@index([status])
  @@index([feedbackType])
}

model LearnedPattern {
  id            String      @id @default(cuid())
  subject       ExamSubject
  patternType   String      @db.VarChar(30) // topic_review, difficulty_adjust, type_correction
  description   String      @db.Text
  confidence    Float       @default(0.5)
  sourceCount   Int         @default(1)
  rule          Json?
  isAutoApplied Boolean     @default(false)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([subject, patternType])
  @@index([isActive, isAutoApplied])
}

// FEAT: 난이도 보정 플라이휠 — 선생님 교정 누적 → 새 분석 자동 보정 맵 (전국 절대 기준, 전역 집계)
// raw 신호(교정 쌍)는 ExamAnalysis.questions JSON 이 source of truth.
// 이 테이블은 recompute job 이 산출한 "적용용 보정 맵"의 빠른 캐시. (과목 × 필드) 1행(upsert).
// 통합 메타데이터 보정 엔진 — 난이도·배점(numeric) + 단원·유형·능력(categorical) 공용.
model MetadataCalibration {
  id               String      @id @default(cuid())
  subject          ExamSubject
  field            String      @db.VarChar(20)    // difficulty | points | topic | question_type | ability_domain
  kind             String      @db.VarChar(12)    // numeric | categorical
  globalBias       Float       @default(0)        // numeric: 전역 평균 Δ. categorical: 미사용(0)
  bucketShifts     Json        @default("{}")     // numeric: { "geometry:3": 0.8 }. categorical: { "geometry": { "function": 7 } } 혼동맵
  totalCorrections Int         @default(0)        // 학습에 쓰인 교정 표본 수
  stats            Json?                          // 대시보드용 전체 통계 스냅샷
  updatedAt        DateTime    @updatedAt
  createdAt        DateTime    @default(now())

  @@unique([subject, field])
  @@index([subject])
}

// 교정 이벤트 로그 (append-only) — 선생님이 메타데이터를 보정한 "모든 이벤트"를 불변 기록.
// MetadataCalibration(집계 캐시)/문항 JSON(최신 상태)과 달리, 빈도·방향·궤적·시계열을 보존하는
// 순수 수집 레이어. AI 동작에 영향 없음(자동보정은 비활성 — 측정/관측·향후 안전한 고도화 토대).
// 변경이 실제로 일어난 경우만(from != to) 1행씩 기록.
model MetadataCorrectionLog {
  id             String   @id @default(cuid())
  examPaperId    String                          // FK 미설정(불변 로그 — 시험지 삭제돼도 이력 보존)
  tenantId       String?
  questionNumber String   @db.VarChar(20)
  field          String   @db.VarChar(20)        // difficulty | topic | points | question_type | ability_domain
  aiValue        String?  @db.VarChar(220)        // 최초 AI 원본값
  fromValue      String?  @db.VarChar(220)        // 이 이벤트 직전 값
  toValue        String?  @db.VarChar(220)        // 교정 후 값
  // ── 패턴 분석 맥락 (스냅샷) ──
  topic          String?  @db.VarChar(220)
  questionType   String?  @db.VarChar(40)
  aiDifficulty   String?  @db.VarChar(10)         // 이 문항을 AI가 본 난이도(버킷용)
  grade          String?  @db.VarChar(30)
  userId         String
  createdAt      DateTime @default(now())

  @@index([field])
  @@index([examPaperId, questionNumber])
  @@index([tenantId])
  @@index([createdAt])
  @@index([field, topic])
}

// ══════════════════════════════════════════════════════════════
// FEAT: 내신대비 자동학습 시스템 (Exam Campaign)
// ══════════════════════════════════════════════════════════════

enum ExamCampaignType {
  MIDTERM // 중간고사
  FINAL // 기말고사
  PERFORMANCE // 수행평가 (확장용)
}

enum ExamCampaignStatus {
  PREPARING // 큐레이션 진행 중
  ACTIVE // 학생 학습 중
  COMPLETED // 시험 후 종료
  ARCHIVED // 보관
}

/// 내신 시험을 D-day까지 자동 학습으로 준비하는 캠페인.
/// 선생님이 학교+학년+시험구분+범위를 지정하면, 큐레이터가
/// 같은/인근 학교 기출 + 단원 매칭 문제 + 출제 패턴을 모아 캠페인 풀을 만든다.

/// 학생별 캠페인 등록. P2에서 schedule(D-day 일정)이 자동 생성된다.

// ── 반 대항전 주간 결과 ──

// ────────────────────────────────────────────────────
// 학생 자습 엔진 대개조 — 신규 모델
// ────────────────────────────────────────────────────

/// 답 보기/힌트 사용 로그 — hidden_answer 뱃지 조건용

/// 일일 가차/룰렛 결과 — 학생당 하루 1회

/// AI 튜터 챗 로그 — Rate limit 및 이력 추적

// FEAT: O/X 퀴즈 (참/거짓 진술) 시스템
// Phase 1: 정적 큐레이션 뱅크 → 자유연습/숙제/인쇄
// 정적 ID 형식: `curated-{cat}-{NNN}` (예: 'curated-m1-pf-001')
//   - statementId FK는 Phase 2에서 활성화 (DB OxStatement 마이그레이션 후)

// ============================================================
// FEAT: 워크북(Workbook) — 인쇄용 책 형식 컨텐츠 묶음
// 프린트 가능한 6종 컨텐츠(시험·문제·연산·숙제·기출·개념)를
// 한 권의 책으로 묶고 각 문항 아래 풀이공간을 인쇄한다.
// ============================================================

enum WorkbookSectionItemKind {
  TEST_PAPER // Test 전체
  QUESTION // 단일 Question (문제은행/시험·숙제 부분 공통)
  ARITHMETIC_DAY // ArithmeticHomeworkPlan dailyProblems[dayIndex]
  CONCEPT_DOC // Concept fullContent
  EXAM_PAPER // ExamPaper 전체 (Question.examPaperId FK)
  HOMEWORK_DAY // QuestionHomeworkPlan dailyQuestions[dayIndex]
  OX_BUNDLE // OxStatement[] (inlineData.statementIds) — 워크북 전용 묶음
}

enum AnswerSpaceSize {
  NONE
  SMALL // ~20mm
  MEDIUM // ~45mm
  LARGE // ~80mm
  XLARGE // ~120mm
}

// ============================================================
// 🚧 수학 랩실 자동화 파이프라인 (Lab) — 상태 척추
//   ⚠️ 격리 규칙: CLAUDE.md "최우선 하드 경계" 참조.
//   - 모든 모델 Lab* 프리픽스 + @@map("lab_*") 로 기출분석 테이블과 물리 격리.
//   - 5단계(진단→처방→공급→채점→보고)는 이 스키마에 대한 순수 함수.
//   - 모든 산출물이 genMode(MANUAL|ASSISTED|AUTO)를 들고 단계별 사람↔자동 플립.
//   - 데이터는 역방향으로 흐른다: Submission/GradedItem → MasteryRecord(진단)
//     → Prescription(처방) → Worksheet(공급) → Submission ... (루프가 닫힘)
// ============================================================

enum LabTrack {
  CURRENT // 현행
  ADVANCED // 선행
}

enum LabGenMode {
  MANUAL // 사람이 직접, 시스템은 기록만
  ASSISTED // 사람 + AI 보조
  AUTO // 완전 자동
}

enum LabProblemType {
  MULTIPLE_CHOICE // 객관식
  SHORT_ANSWER // 단답
  DESCRIPTIVE // 서술형
}

enum LabErrorType {
  NONE // 정답
  CALCULATION // 계산 실수
  CONCEPT // 개념 오류
  INCOMPLETE // 풀이 미완
  MISREAD // 문제 이해 오류
  OTHER
}

enum LabWorksheetStatus {
  PRESCRIBED // 처방됨 (아직 미생성)
  SUPPLIED // HWP 생성 완료
  SUBMITTED // 답안 제출됨
  GRADED // 채점 완료
}

enum LabReportType {
  PARENT
  DIRECTOR
}

// ── 학생 ───────────────────────────────────────────
model LabStudent {
  id        String   @id @default(cuid())
  name      String
  grade     String? // 학년
  createdAt DateTime @default(now())

  pacing        LabPacingPosition?
  mastery       LabMasteryRecord[]
  prescriptions LabPrescription[]
  worksheets    LabWorksheet[]
  submissions   LabSubmission[]
  reports       LabReport[]

  @@map("lab_students")
}

// ── 교육과정 개념 그래프 (84개월 진도표 JSON에서 시드) ──
model LabConcept {
  id         String   @id // 진도표 conceptId 그대로 사용
  name       String
  track      LabTrack
  monthIdx   Int // 진도표상 위치 (개월)
  sessionIdx Int // 회차
  domain     String? // 영역 (수와연산, 도형, 측정 ...)

  // 선수개념 그래프 (BKT 전파 / 처방 게이팅에 사용)
  prereqOf  LabConceptEdge[] @relation("labPrereq")
  dependsOn LabConceptEdge[] @relation("labDependent")

  mastery           LabMasteryRecord[]
  problems          LabProblem[]
  prescriptionItems LabPrescriptionItem[]

  @@index([track, monthIdx, sessionIdx])
  @@map("lab_concepts")
}

model LabConceptEdge {
  id          String     @id @default(cuid())
  prereqId    String // 선수 개념
  dependentId String // 의존 개념
  prereq      LabConcept @relation("labPrereq", fields: [prereqId], references: [id])
  dependent   LabConcept @relation("labDependent", fields: [dependentId], references: [id])

  @@unique([prereqId, dependentId])
  @@map("lab_concept_edges")
}

// ── 진단 산출물: 학생 × 개념 숙련도 (masteryMap) ──────
model LabMasteryRecord {
  id               String     @id @default(cuid())
  studentId        String
  conceptId        String
  student          LabStudent @relation(fields: [studentId], references: [id])
  concept          LabConcept @relation(fields: [conceptId], references: [id])
  score            Float // 0..1 숙련 확률 (BKT p(mastered))
  observationCount Int        @default(0) // 관측 수 → confidence 대용
  lastObservedAt   DateTime?
  updatedAt        DateTime   @updatedAt
  genMode          LabGenMode @default(MANUAL)

  @@unique([studentId, conceptId])
  @@index([conceptId, score]) // 원장 대시보드: "이 개념 약한 학생 N명"
  @@map("lab_mastery_records")
}

model LabPacingPosition {
  id         String     @id @default(cuid())
  studentId  String     @unique
  student    LabStudent @relation(fields: [studentId], references: [id])
  track      LabTrack
  monthIdx   Int
  sessionIdx Int
  updatedAt  DateTime   @updatedAt

  @@map("lab_pacing_positions")
}

// ── 처방 산출물 ────────────────────────────────────
model LabPrescription {
  id        String     @id @default(cuid())
  studentId String
  student   LabStudent @relation(fields: [studentId], references: [id])
  createdAt DateTime   @default(now())
  genMode   LabGenMode @default(MANUAL)
  rationale String? // 처방 근거 요약 (사람/AI)

  items      LabPrescriptionItem[]
  worksheets LabWorksheet[]

  @@index([studentId, createdAt])
  @@map("lab_prescriptions")
}

model LabPrescriptionItem {
  id             String          @id @default(cuid())
  prescriptionId String
  conceptId      String
  prescription   LabPrescription @relation(fields: [prescriptionId], references: [id])
  concept        LabConcept      @relation(fields: [conceptId], references: [id])
  difficulty     Int // 1..5
  count          Int // 출제 문항 수
  order          Int // 처방 내 순서
  reason         String? // 이 개념을 처방한 이유 (약점 점수 등)

  @@map("lab_prescription_items")
}

// ── 공급 reference data: 문제은행 ──────────────────
model LabProblem {
  id          String         @id @default(cuid())
  conceptId   String
  concept     LabConcept     @relation(fields: [conceptId], references: [id])
  type        LabProblemType
  difficulty  Int // 1..5
  source      String? // 출처 / 생성 모델
  isGenerated Boolean        @default(false) // AI 생성 여부
  bodyRef     String // HWP/이미지/LaTeX 본문 참조 (스토리지 키)
  answer      Json // 정답 (객관식 번호 / 단답 / 서술형 채점 루브릭)
  createdAt   DateTime       @default(now())

  worksheetProblems LabWorksheetProblem[]
  gradedItems       LabGradedItem[]

  @@index([conceptId, difficulty, type])
  @@map("lab_problems")
}

// ── 공급 산출물: 학생에게 나간 시험지/워크시트 ──────
model LabWorksheet {
  id             String             @id @default(cuid())
  studentId      String
  prescriptionId String?
  student        LabStudent         @relation(fields: [studentId], references: [id])
  prescription   LabPrescription?   @relation(fields: [prescriptionId], references: [id])
  status         LabWorksheetStatus @default(PRESCRIBED)
  hwpUrl         String? // 생성된 HWP 스토리지 URL
  genMode        LabGenMode         @default(MANUAL)
  createdAt      DateTime           @default(now())

  problems   LabWorksheetProblem[]
  submission LabSubmission?

  @@index([studentId, status])
  @@map("lab_worksheets")
}

model LabWorksheetProblem {
  id          String       @id @default(cuid())
  worksheetId String
  problemId   String
  worksheet   LabWorksheet @relation(fields: [worksheetId], references: [id])
  problem     LabProblem   @relation(fields: [problemId], references: [id])
  order       Int

  @@unique([worksheetId, problemId])
  @@map("lab_worksheet_problems")
}

// ── 채점 산출물 ────────────────────────────────────
model LabSubmission {
  id          String       @id @default(cuid())
  worksheetId String       @unique
  studentId   String
  worksheet   LabWorksheet @relation(fields: [worksheetId], references: [id])
  student     LabStudent   @relation(fields: [studentId], references: [id])
  answerRef   String? // 스캔/사진 답안 스토리지 키
  gradedAt    DateTime?
  genMode     LabGenMode   @default(MANUAL)
  createdAt   DateTime     @default(now())

  items LabGradedItem[]

  @@index([studentId, gradedAt])
  @@map("lab_submissions")
}

model LabGradedItem {
  id           String        @id @default(cuid())
  submissionId String
  problemId    String
  submission   LabSubmission @relation(fields: [submissionId], references: [id])
  problem      LabProblem    @relation(fields: [problemId], references: [id])
  correct      Boolean
  partialScore Float? // 서술형 부분점수 0..1
  errorType    LabErrorType  @default(NONE)
  confidence   Float? // AI 채점 신뢰도 0..1 (낮으면 needsReview)
  needsReview  Boolean       @default(false) // 사람 검수 큐로 보낼지

  @@index([problemId])
  @@map("lab_graded_items")
}

// ── 보고 산출물 ────────────────────────────────────
model LabReport {
  id          String        @id @default(cuid())
  studentId   String
  student     LabStudent    @relation(fields: [studentId], references: [id])
  type        LabReportType
  periodStart DateTime
  periodEnd   DateTime
  url         String? // 생성된 리포트(PDF/HWP) URL
  summary     Json? // 핵심 지표 스냅샷
  genMode     LabGenMode    @default(MANUAL)
  createdAt   DateTime      @default(now())

  @@index([studentId, type, createdAt])
  @@map("lab_reports")
}

