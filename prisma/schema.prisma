  PENDING
  ANSWERED
}

model Inquiry {
  id          String        @id @default(cuid())
  academyName String
  contactName String
  phone       String
  email       String?
  region      String?
  message     String?
  status      InquiryStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// FEAT: Diagnostic Test Results

// FEAT: Level Test Configuration

// FEAT: Parent & Report System

// FEAT: Real-time Quiz Battle
enum QuizStatus {
  WAITING
  ACTIVE
  COMPLETED
}

// School Information (나이스 API 수집)
model School {
  id              String    @id @default(cuid())
  schoolCode      String?   @unique @db.VarChar(20) // 나이스 표준학교코드
  name            String    @db.VarChar(100)
  schoolType      String    @db.VarChar(20) // elementary, middle, high
  regionCode      String?   @db.VarChar(10) // 시도교육청코드 (B10=서울 등)
  regionName      String?   @db.VarChar(30) // 시도명 (서울, 경기 등)
  city            String    @db.VarChar(50) // 시도 (레거시 호환)
  district        String    @db.VarChar(50) // 시군구
  address         String?   @db.VarChar(300) // 도로명주소
  latitude        Float?
  longitude       Float?
  foundationType  String?   @db.VarChar(20) // 국립/공립/사립
  coeducationType String?   @db.VarChar(20) // 남녀공학구분
  highSchoolType  String?   @db.VarChar(30) // 고교유형
  phoneNumber     String?   @db.VarChar(30)
  homepageUrl     String?   @db.VarChar(300)
  foundationDate  String?   @db.VarChar(20)
  zoneId          String?   @db.VarChar(30) // 학구ID (학구도 API)
  eduSupportCode  String?   @db.VarChar(20) // 교육지원청코드
  eduSupportName  String?   @db.VarChar(50) // 교육지원청명
  nearbyGroupId   String?   @db.VarChar(50) // 주변 학교 그룹 (같은 ID = 같은 그룹)
  createdAt       DateTime  @default(now())
  dataUpdatedAt   DateTime?

  examPapers    ExamPaper[]

  @@index([city, district])
  @@index([schoolType])
  @@index([regionCode])
  @@index([name])
  @@index([zoneId])
  @@index([nearbyGroupId])
}

// 지점별 주변 학교 그룹 커스텀 (SUPER_ADMIN 디폴트를 지점이 오버라이드)
model TenantNearbyGroup {
  id        String   @id @default(cuid())
  tenantId  String
  schoolId  String // 기준 학교
  groupId   String   @db.VarChar(50) // 그룹ID (같은 값 = 같은 그룹)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, schoolId]) // 지점당 학교 하나의 그룹만
  @@index([tenantId, groupId])
  @@index([groupId])
}

